{
  "name": "@mttzzz/nuxt-sentry",
  "version": "0.7.1",
  "description": "Nuxt 4 module: shared Sentry boilerplate (Bun server init, client init, nitro error capture, tunnel, portable postgres-js instrumentation)",
  "license": "MIT",
  "repository": "github:mttzzz/nuxt-sentry",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./utils": {
      "types": "./dist/runtime/utils/instrument-postgres-js.d.ts",
      "import": "./dist/runtime/utils/instrument-postgres-js.js"
    },
    "./logger": {
      "types": "./dist/runtime/utils/logger.d.ts",
      "import": "./dist/runtime/utils/logger.js"
    },
    "./logger/client": {
      "types": "./dist/runtime/utils/client-logger.d.ts",
      "import": "./dist/runtime/utils/client-logger.js"
    },
    "./cron": {
      "types": "./dist/runtime/utils/sentry-cron.d.ts",
      "import": "./dist/runtime/utils/sentry-cron.js"
    },
    "./queue": {
      "types": "./dist/runtime/utils/sentry-queue.d.ts",
      "import": "./dist/runtime/utils/sentry-queue.js"
    },
    "./task": {
      "types": "./dist/runtime/utils/define-sentry-task.d.ts",
      "import": "./dist/runtime/utils/define-sentry-task.js"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "oxlint --type-aware -f unix",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.5",
    "defu": "^6.1.4",
    "h3": "^1.15.0"
  },
  "devDependencies": {
    "@mttzzz/nuxt-stale-deploy-guard": "github:mttzzz/nuxt-stale-deploy-guard#main",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.5",
    "@nuxt/test-utils": "^4.0.3",
    "@sentry/bun": "^10.69.0",
    "@sentry/core": "^10.69.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@sentry/vue": "^10.69.0",
    "@types/node": "25.7.0",
    "bull": "^4.16.5",
    "nuxt": "^4.4.5",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.8"
  },
  "peerDependencies": {
    "@sentry/bun": "^10.52.0",
    "@sentry/core": "^10.52.0",
    "@sentry/vite-plugin": "^5.0.0",
    "@sentry/vue": "^10.52.0",
    "bull": "^4.0.0",
    "nuxt": "^4.4.5"
  },
  "peerDependenciesMeta": {
    "bull": {
      "optional": true
    }
  }
}
