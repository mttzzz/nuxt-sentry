{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "singleAttributePerLine": true,
  "vueIndentScriptAndStyle": false,
  "htmlWhitespaceSensitivity": "css",
  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["~/", "~~/", "@/", "#"]
  },
  "sortPackageJson": {
    "sortScripts": false
  },
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": {
        "printWidth": 80,
        "tabWidth": 2
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist",
    "playground/.nuxt",
    "playground/.output"
  ]
}
